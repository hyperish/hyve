[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
publish = false

# `#[table]` and `#[server]` keep their server-side code only with the
# `server` feature; a backend-only package always builds it.
[features]
cache-redis = ["server"]
default = ["server"]
server = []

[dependencies]
hyve = "={{hyve}}"
orbic = "={{orbic}}"
tokio = { version = "1", features = ["macros", "net", "rt-multi-thread", "signal"] }

[dev-dependencies]
hyve = { version = "={{hyve}}", features = ["test"] }

# `hyve dev` builds and runs this server, gives it a local database, and
# restarts it when a source changes.
[package.metadata.orbic.server]
cache_features = ["cache-redis", "orbic/cache-redis"]

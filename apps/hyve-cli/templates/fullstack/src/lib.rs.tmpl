//! {{name}}: a serge UI for the browser and the desktop, and the orbic
//! backend it calls.

mod notes;

use std::sync::Arc;

use hyve::api::Transport;
use serge::prelude::*;

pub use notes::*;

/// The app, calling the backend through `transport`.
pub fn app(transport: Arc<dyn Transport>) -> SergeApp {
    SergeApp::new()
        .title("{{name}}")
        .transport(transport)
        .feature(feature().route("/", Notes))
}

/// The browser entry: the page's own origin, which forwards `/v1` to the
/// backend.
#[cfg(target_arch = "wasm32")]
#[wasm_bindgen::prelude::wasm_bindgen(start)]
pub fn start() {
    app(RemoteTransport::new("/v1").into_arc()).run();
}

/// The Android NativeActivity entry.
#[cfg(target_os = "android")]
#[allow(unsafe_code)]
#[unsafe(no_mangle)]
fn android_main(host: serge::android::AndroidApp) {
    if let Err(error) = serge::android::launch(host, app(RemoteTransport::new(option_env!("SERGE_API_URL").unwrap_or("http://127.0.0.1:3000/v1")).into_arc())) {
        eprintln!("Serge activity failed: {error}");
    }
}
